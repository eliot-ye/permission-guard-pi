{
  "name": "permission-guard-pi",
  "version": "0.2.0",
  "description": "Layered, configurable file-access control for pi-coding-agent. Dual region (project_inner / project_outer) x three-tier permissions (read_write / read_only / unread), with session- and persistent-grant memory, audit log, and default-sensitive-path fallback.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "permissions",
    "access-control",
    "safety",
    "audit-log"
  ],
  "license": "MIT",
  "author": "Eliot <eliot_ye@163.com>",
  "type": "module",
  "main": "extensions/index.ts",
  "homepage": "https://github.com/eliot-ye/permission-guard-pi#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/eliot-ye/permission-guard-pi"
  },
  "bugs": {
    "url": "https://github.com/eliot-ye/permission-guard-pi/issues"
  },
  "files": [
    "extensions/index.ts",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"extensions/*.test.ts\"",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
